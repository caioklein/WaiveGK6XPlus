<Window x:Class="Waive.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Waive.Desktop"
 Title="WaiveGK6XPlus" Icon="{StaticResource WaiveIcon}" Width="1200" Height="990" MinWidth="1120" MinHeight="840" Background="#101720" FontFamily="Segoe UI" ShowInTaskbar="True" ResizeMode="CanResize"
 Loaded="WindowLoaded" Closing="WindowClosing" StateChanged="WindowStateChanged" WindowStartupLocation="CenterScreen">
 <Grid Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="#68E4CC" CornerRadius="9" Padding="10,6" Margin="0,0,12,0"><TextBlock Text="W" Foreground="#101720" FontWeight="Bold" FontSize="22"/></Border>
    <TextBlock Text="WaiveGK6XPlus" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text=" /  KEYBOARD" FontSize="11" Foreground="#8296AB" VerticalAlignment="Center" Margin="12,4,0,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="MinimizeButton" Content="—  Minimize to tray" Click="MinimizeClicked" Padding="12,8" Margin="0,0,12,0" AutomationProperties.Name="Minimize WaiveGK6XPlus to system tray"/><Border Background="#202D38" CornerRadius="12" Padding="12,5" VerticalAlignment="Center"><TextBlock Text="NATIVE EDITOR  ·  0.4" Foreground="#A9BDC9" FontSize="10"/></Border></StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="#192530" CornerRadius="12" Padding="18">
     <StackPanel>
      <TextBlock Text="YOUR KEYBOARD" Foreground="#8AA0B2" FontSize="10" FontWeight="SemiBold"/>
      <TextBlock x:Name="DeviceName" Text="Not connected" FontSize="19" FontWeight="SemiBold" Margin="0,13,0,8"/>
      <TextBlock x:Name="DeviceDetail" Text="Connect your keyboard by USB, then scan for it." Foreground="#A1B2C3" FontSize="12" LineHeight="19" MinHeight="58"/>
      <ComboBox x:Name="DeviceSelector" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.Name="Keyboard to connect"/>
      <Button x:Name="ConnectButton" Content="Scan for keyboard" Click="ScanClicked" Margin="0,14,0,0" AutomationProperties.Name="Scan for supported USB keyboards"/>
     </StackPanel>
    </Border>
    <Border Background="#192530" CornerRadius="12" Padding="16" Margin="0,14,0,0">
     <StackPanel>
      <TextBlock Text="PROFILES ON THIS PC" FontSize="10" Foreground="#8AA0B2"/>
      <ComboBox x:Name="ProfileList" Margin="0,10,0,8" SelectionChanged="ProfileChanged" AutomationProperties.Name="Saved profile"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="15" Height="15" CornerRadius="4" Background="{Binding Color}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" Foreground="#EAF1F6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="140" ToolTip="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBox x:Name="ProfileName" Text="My keyboard" MaxLength="100" LostFocus="ProfileRenamed" AutomationProperties.Name="Profile name"/>
      <WrapPanel Margin="0,10,0,0"><Button Content="Save" Click="SaveProfileClicked" Padding="12,8" Margin="0,0,6,6"/><Button Content="New" Click="NewProfileClicked" Padding="12,8" Margin="0,0,6,6"/><Button Content="Copy" Click="CopyProfileClicked" Padding="12,8" Margin="0,0,0,6"/></WrapPanel>
      <WrapPanel><Button Content="Import" Click="ImportProfileClicked" Padding="12,8" Margin="0,0,6,6"/><Button Content="Export" Click="ExportProfileClicked" Padding="12,8" Margin="0,0,6,6"/><Button Content="Delete" Click="DeleteProfileClicked" Padding="12,8" Margin="0,0,0,6"/></WrapPanel>
      <TextBlock x:Name="ProfileStatus" Text="New · not saved" Foreground="#8AA0B2" FontSize="11" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>
    <Border Background="#192530" CornerRadius="12" Padding="16" Margin="0,14,0,0"><StackPanel>
      <TextBlock Text="WHERE THIS PROFILE RUNS" FontSize="10" Foreground="#8AA0B2" Margin="0,0,0,12"/>
      <RadioButton x:Name="LiveOption" Content="Live · app stays running" IsChecked="True" Checked="ModeChanged" Margin="0,0,0,10"/>
      <RadioButton x:Name="StoredOption" Content="Onboard · runs on keyboard" Checked="ModeChanged" Margin="0,0,0,10"/>
      <TextBlock x:Name="LayerCaption" FontSize="10" Foreground="#8AA0B2" Margin="0,0,0,6"/>
      <ComboBox x:Name="LayerSelector" SelectionChanged="LayerChanged" AutomationProperties.Name="Onboard target or return layer"/>
      <TextBlock x:Name="ModeDescription" Foreground="#92A9BA" FontSize="11" Margin="0,9,0,0" LineHeight="17"/>
    </StackPanel></Border>
    <TextBlock Text="Save keeps a copy on this PC. Apply sends it to the keyboard. Live features need the app running." FontSize="12" Foreground="#7F95AA" Margin="4,18,4,0" LineHeight="19"/>
    <Button Content="Save diagnostics" Click="DiagnosticsClicked" Background="#18222D" Margin="0,18,0,0" ToolTip="Save connection details and operation results locally. No keystrokes are recorded."/>
    <CheckBox x:Name="ShowTray" Content="Always show tray icon" Foreground="#97ACBE" Margin="4,16,0,0" Checked="TrayOptionChanged" Unchecked="TrayOptionChanged"/>
    <CheckBox x:Name="StartWithWindows" Content="Start minimized with Windows" Foreground="#97ACBE" Margin="4,10,0,12" Checked="StartupOptionChanged" Unchecked="StartupOptionChanged"/>
   </StackPanel></ScrollViewer>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
     <TextBlock Text="Make it yours." FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="1  Select keys    →    2  Choose colors or effects    →    3  Apply to keyboard" Foreground="#97ACBE" FontSize="13" Margin="0,5,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="#192530" CornerRadius="12" Padding="20" Margin="0,0,0,16">
     <StackPanel>
      <DockPanel><TextBlock Text="SELECT KEYS TO EDIT" FontSize="10" Foreground="#8DA5B5" FontWeight="SemiBold"/><TextBlock x:Name="PreviewLabel" Text="96XS layout · visual preview" Foreground="#8DA5B5" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
      <WrapPanel Margin="0,8,0,0">
       <Button Content="Select all" Click="SelectAllClicked" Padding="10,5" Margin="0,0,7,0"/><Button Content="Clear selection" Click="ClearSelectionClicked" Padding="10,5" Margin="0,0,7,0"/>
       <Button Content="Undo" Click="UndoClicked" Padding="10,5" Margin="0,0,7,0"/><Button Content="Redo" Click="RedoClicked" Padding="10,5" Margin="0,0,7,0"/>
       <TextBlock x:Name="SelectionText" Text="All keys selected" FontSize="11" VerticalAlignment="Center" Foreground="#9AB1C2"/>
      </WrapPanel>
      <Viewbox Stretch="Uniform" Height="180" Margin="0,12,0,0"><Canvas x:Name="KeyboardCanvas" Background="Transparent" Width="930" Height="295"/></Viewbox>
      <TextBlock Text="Drag across keys to select · Ctrl-drag adds or removes · Alt-drag removes · ◆ means key-press glow" Foreground="#9AB1C2" FontSize="11" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    <TabControl Grid.Row="2" x:Name="EditorTabs"><TabItem Header="Colors &amp; effects"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="#192530" CornerRadius="8" Padding="18">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Paint selected keys" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="ColorSelectionHint" Text="Picking a shade paints the selected keys" Foreground="#9CB2C3" FontSize="11" Margin="0,6,0,10"/>
      <local:ColorPicker x:Name="Picker" Height="142"/>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
       <Border x:Name="SelectedColorChip" Width="36" Height="36" CornerRadius="7" Margin="0,0,9,0"/>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CURRENT COLOR" FontSize="9" Foreground="#8DA5B5"/><TextBlock x:Name="SelectedColorText" FontSize="13"/></StackPanel>
       <TextBox x:Name="HexBox" Grid.Column="2" Text="#68E4CC" TextChanged="HexChanged" MaxLength="9" Padding="9,8" AutomationProperties.Name="Hex RGB color"/>
      </Grid>
      <WrapPanel x:Name="Swatches" Margin="0,10,0,0"/>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions>
       <TextBlock Text="Brightness" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BrightnessChanged" VerticalAlignment="Center" AutomationProperties.Name="Keyboard brightness"/>
       <TextBlock x:Name="BrightnessText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Choose a lighting look" FontSize="17" FontWeight="SemiBold"/>
      <WrapPanel Margin="0,9,0,9"><TextBlock Text="Preset applies to:" FontSize="11" Margin="0,0,9,0"/><RadioButton x:Name="SelectionScope" GroupName="LookScope" Content="Selected keys" IsChecked="True" Checked="LightingScopeChanged" FontSize="11" Margin="0,0,10,0"/><RadioButton x:Name="WholeKeyboardScope" GroupName="LookScope" Content="All keys" Checked="LightingScopeChanged" FontSize="11" Margin="0"/></WrapPanel>
      <UniformGrid x:Name="PresetPanel" Columns="2"/>
      <DockPanel Margin="0,3,0,6"><TextBlock Text="PROFILE LOOK" Foreground="#8DA5B5" FontSize="10"/><TextBlock x:Name="LightingStatus" HorizontalAlignment="Right" FontSize="10" Foreground="#68E4CC"/></DockPanel>
      <ComboBox x:Name="EffectChoice" SelectionChanged="EffectChanged" AutomationProperties.Name="Profile lighting effect"/>
      <CheckBox x:Name="AnimatePreview" Content="Animate keyboard preview" Foreground="#A9BFCE" Margin="0,9,0,12" Checked="PreviewOptionChanged" Unchecked="PreviewOptionChanged"/>
      <Expander Header="More key-press effects" Foreground="#A9BFCE"><StackPanel Margin="0,9,0,0">
      <TextBlock Text="WHEN A KEY IS PRESSED" Foreground="#8DA5B5" FontSize="10"/>
      <ComboBox x:Name="KeyEffectChoice" Margin="0,6,0,8" AutomationProperties.Name="Effect triggered by selected keys"/>
      <WrapPanel><Button Content="Assign glow" Click="AssignKeyEffectClicked" Padding="10,7" Margin="0,0,6,6"/><Button Content="Preview" Click="PreviewKeyGlowClicked" Padding="10,7" Margin="0,0,6,6"/><Button Content="Remove" Click="ClearKeyEffectClicked" Padding="10,7" Margin="0,0,0,6"/></WrapPanel>
      <TextBlock x:Name="KeyGlowStatus" Foreground="#9CB2C3" FontSize="10"/>
      </StackPanel></Expander>
     </StackPanel></Grid>
    </Border></ScrollViewer></TabItem>
     <TabItem Header="Key mapping"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="#192530" Padding="18"><StackPanel>
      <TextBlock Text="Assign an action to the selected keys" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="Select keys in the keyboard above. Choose a key, media action, shortcut, or macro." Foreground="#92A9BA" FontSize="12" Margin="0,8,0,10"/>
      <WrapPanel><CheckBox x:Name="EditFn" Content="Edit Fn layer (onboard only)" Foreground="#EAF1F6" Margin="0,0,15,10" Checked="FnViewChanged" Unchecked="FnViewChanged"/><TextBlock x:Name="BindingSummary" FontSize="12" Foreground="#92A9BA"/></WrapPanel>
      <ComboBox x:Name="BindingChoice" IsEditable="True" Margin="0,0,0,10" AutomationProperties.Name="Key action or shortcut"/>
      <WrapPanel><Button Content="Assign to selected" Click="AssignBindingClicked" Margin="0,0,8,8"/><Button Content="Restore selected defaults" Click="ClearBindingClicked" Margin="0,0,8,8"/></WrapPanel>
      <TextBlock Text="Shortcut example: LCtrl+LShift+P. The Fn key itself is reserved. Macro playback supports repeat, hold, and toggle." FontSize="12" Foreground="#92A9BA"/>
      <TextBlock Text="Open a website, file, or program · live mode only" Margin="0,16,0,8" FontSize="14"/>
      <TextBox x:Name="OpenTarget" AutomationProperties.Name="Website address or full file path" ToolTip="Enter an https:// address, or browse for a file or program. Command arguments are not supported."/>
      <WrapPanel Margin="0,8,0,0"><Button Content="Browse…" Click="BrowseTargetClicked" Margin="0,0,8,0"/><Button Content="Assign open action" Click="AssignOpenClicked"/></WrapPanel>
     </StackPanel></Border></ScrollViewer></TabItem>
     <TabItem Header="Libraries"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="#192530" Padding="18"><StackPanel>
      <WrapPanel><Button Content="Macro library and recorder" Click="MacrosClicked" Margin="0,0,10,10"/><Button Content="Lighting editor" Click="EffectsClicked" Margin="0,0,10,10"/></WrapPanel>
      <TextBlock Text="Build custom frame sequences, import lighting files, or record a macro here. Choose and assign your finished lighting effects on the Colors &amp; effects tab." Foreground="#92A9BA" FontSize="13" Margin="0,4,0,14"/>
      <TextBlock Text="Animations update only while active. Macro recording starts only when you click Record; F12 stops recording." Foreground="#92A9BA" FontSize="12"/>
     </StackPanel></Border></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="3" Margin="0,16,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
      <TextBlock x:Name="ResultText" Text="Preview only · connect a keyboard to apply." Foreground="#A3BAC9" FontSize="12"/>
      <ProgressBar x:Name="ApplyProgress" Height="3" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,6,0,0" Foreground="#68E4CC"/>
     </StackPanel>
     <Button x:Name="StopButton" Grid.Column="1" Content="Stop live profile" Click="StopClicked" Visibility="Collapsed" Margin="0,0,10,0"/>
     <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply to keyboard" Click="ApplyClicked" Background="#68E4CC" Foreground="#102126" FontWeight="SemiBold" IsEnabled="False"/>
    </Grid>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,20,0,0">
   <TextBlock Text="LOCAL FIRST  /  ENGLISH ONLY" Foreground="#6F879A" FontSize="10"/>
   <TextBlock x:Name="FooterStatus" Text="No background work" Foreground="#6F879A" FontSize="10" HorizontalAlignment="Right"/>
  </DockPanel>
 </Grid>
</Window>




